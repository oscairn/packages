{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://packages.oscairn.org/schemas/library-release.schema.json",
  "title": "oscairn-release.json, the manifest of a library-only release (kind library) on one of Oscairn's repositories",
  "description": "scripts/import-release.py checks a release whose manifest has kind library against this: a package of item types with no plugin and no builds. It knows only the keywords used here, and refuses a schema using any other, so keep to them. Every pattern is anchored.",
  "type": "object",
  "required": ["format", "version", "kind", "package", "tags", "files", "source", "license", "licenseFiles"],
  "additionalProperties": false,
  "properties": {
    "format": { "const": "oscairn.library-release" },
    "version": { "type": "integer", "const": 1 },
    "kind": { "const": "library" },
    "package": {
      "type": "object",
      "required": ["id", "version", "name", "summary"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Za-z0-9_-]+(\\.[A-Za-z0-9_-]+)+$", "maxLength": 128 },
        "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$", "maxLength": 32 },
        "name": { "type": "string", "minLength": 1, "maxLength": 128 },
        "summary": { "type": "string", "minLength": 1, "maxLength": 500 }
      }
    },
    "tags": {
      "type": "array",
      "maxItems": 16,
      "items": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9 ._-]{0,63}$" }
    },
    "files": {
      "description": "The package's tree: each file a release asset (file), with its path inside the package. Only Types/<package id>/<name>.json, the item types the package declares",
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "required": ["file", "path", "sha256", "size"],
        "additionalProperties": false,
        "properties": {
          "file": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$" },
          "path": { "type": "string", "pattern": "^Types/[A-Za-z0-9_-]+(\\.[A-Za-z0-9_-]+)+/[A-Za-z0-9][A-Za-z0-9._-]{0,127}\\.json$" },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "size": { "type": "integer", "minimum": 1, "maximum": 65536 }
        }
      }
    },
    "source": {
      "type": "object",
      "required": ["url", "revision", "tag"],
      "additionalProperties": false,
      "properties": {
        "url": { "type": "string", "pattern": "^https://github\\.com/oscairn/[A-Za-z0-9._-]+$" },
        "revision": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "tag": { "type": "string", "pattern": "^(?:oscairn-|[A-Za-z0-9_-]+(?:\\.[A-Za-z0-9_-]+)+-)?v[0-9]+\\.[0-9]+\\.[0-9]+$" }
      }
    },
    "license": { "type": "string", "pattern": "^[A-Za-z0-9.+() -]{1,256}$" },
    "licenseFiles": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "required": ["file", "sha256"],
        "additionalProperties": false,
        "properties": {
          "file": { "type": "string", "pattern": "^licenses/[A-Za-z0-9][A-Za-z0-9._-]{0,127}$" },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        }
      }
    },
    "dependencies": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "packages": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "object",
            "required": ["id", "version"],
            "additionalProperties": false,
            "properties": {
              "id": { "type": "string", "pattern": "^[A-Za-z0-9_-]+(\\.[A-Za-z0-9_-]+)+$", "maxLength": 128 },
              "version": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9.+_-]{0,63}$" }
            }
          }
        }
      }
    }
  }
}
