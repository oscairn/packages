{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://packages.oscairn.org/schemas/plugin-release.schema.json",
  "title": "oscairn-release.json, the manifest of a plugin release on one of Oscairn's forks",
  "description": "scripts/import-release.py checks a release against this. It knows only the keywords used here, and refuses a schema using any other, so keep to them. Every pattern is anchored.",
  "type": "object",
  "required": ["format", "version", "package", "plugins", "builds", "source", "license", "licenseFiles", "clap", "oscairnClap"],
  "additionalProperties": false,
  "properties": {
    "format": { "const": "oscairn.plugin-release" },
    "version": { "type": "integer", "const": 1 },
    "package": {
      "type": "object",
      "required": ["id", "version", "name", "summary"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Za-z0-9_-]+(\\.[A-Za-z0-9_-]+)+$", "maxLength": 128 },
        "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$", "maxLength": 32 },
        "name": { "type": "string", "minLength": 1, "maxLength": 128 },
        "summary": { "type": "string", "minLength": 1, "maxLength": 500 }
      }
    },
    "plugins": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "required": ["format", "id", "version", "name", "kind"],
        "additionalProperties": false,
        "properties": {
          "format": { "const": "clap" },
          "id": { "type": "string", "pattern": "^[A-Za-z0-9_-]+(\\.[A-Za-z0-9_-]+)+$", "maxLength": 128 },
          "version": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9.+_-]{0,63}$" },
          "name": { "type": "string", "minLength": 1, "maxLength": 128 },
          "kind": {
            "description": "How oscairn-plugin-check plays it: a synth is played notes, an effect a signal, a note effect notes and checked for the notes it sends",
            "enum": ["synth", "effect", "note-effect"]
          }
        }
      }
    },
    "builds": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "required": ["platform", "file", "sha256", "size"],
        "additionalProperties": false,
        "properties": {
          "platform": { "enum": ["linux-arm64", "linux-x86_64", "macos-arm64", "macos-x86_64", "windows-x86_64"] },
          "file": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$" },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "size": { "type": "integer", "minimum": 1, "maximum": 1992294400 }
        }
      }
    },
    "source": {
      "type": "object",
      "required": ["url", "revision", "tag"],
      "additionalProperties": false,
      "properties": {
        "url": { "type": "string", "pattern": "^https://github\\.com/oscairn/[A-Za-z0-9._-]+$" },
        "revision": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "tag": { "type": "string", "pattern": "^(oscairn-)?v[0-9]+\\.[0-9]+\\.[0-9]+$" }
      }
    },
    "license": { "type": "string", "pattern": "^[A-Za-z0-9.+() -]{1,256}$" },
    "licenseFiles": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "required": ["file", "sha256"],
        "additionalProperties": false,
        "properties": {
          "file": { "type": "string", "pattern": "^licenses/[A-Za-z0-9][A-Za-z0-9._-]{0,127}$" },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        }
      }
    },
    "dependencies": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "assets": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "object",
            "required": ["id", "version"],
            "additionalProperties": false,
            "properties": {
              "id": { "type": "string", "pattern": "^[A-Za-z0-9_-]+(\\.[A-Za-z0-9_-]+)+$", "maxLength": 128 },
              "version": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9.+_-]{0,63}$" }
            }
          }
        }
      }
    },
    "clap": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "oscairnClap": { "type": "string", "pattern": "^[0-9a-f]{7,40}$" }
  }
}
